{
  "name": "financity",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web && npm run build -w apps/api",
    "test:api": "npm run test -w apps/api",
    "pg:dev": "npm run pg:dev -w apps/api"
  },
  "engines": {
    "node": "22.x"
  }
}
