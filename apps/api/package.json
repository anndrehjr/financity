    "pg": "^8.13.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "better-sqlite3": "^11.5.0",
    "embedded-postgres": "16.15.0-beta.19",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
