# Copie para .env.production (chmod 600) e preencha NA VPS. Este arquivo NUNCA vai para o git nem para a Vercel.
# Gerar valores fortes:  openssl rand -base64 48 | tr -d '\n='

# Senha do PostgreSQL (só a API usa)
POSTGRES_PASSWORD=

# Segredo do HMAC dos PINs. Precisa ser EXATAMENTE o valor de data/secret.key do sistema atual (SQLite),
# senão a verificação de "PIN único" deixa de reconhecer os PINs já cadastrados. 32+ caracteres.
FINANCITY_SECRET=

# Segredo compartilhado com a Vercel (variável GATEWAY_SECRET lá). 32+ caracteres, diferente dos demais.
GATEWAY_SECRET=

# Origem do site na Vercel (https). Só depois de definir o domínio. Exemplo de formato: https://jogos.SEU-DOMINIO
ALLOWED_ORIGINS=

# Nome da rede Docker do Nginx Proxy Manager (confira com: docker network ls)
PROXY_NETWORK=docker_proxy
API_TAG=local
